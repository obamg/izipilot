# IziPilot Cron Jobs (UTC — Bénin = UTC+1, donc -1h)
# Rappel dimanche 20h00 WAT = 19h00 UTC (deadline saisie dimanche 23h59 WAT)
0 19 * * 0 . /etc/cron.env; wget -qO- --header="Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/weekly-reminder > /dev/null 2>&1
# Check alertes quotidien 10h WAT = 9h UTC
0 9 * * * . /etc/cron.env; wget -qO- --header="Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/check-alerts > /dev/null 2>&1
# Digest hebdo lundi 10h WAT = 9h UTC
0 9 * * 1 . /etc/cron.env; wget -qO- --header="Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/weekly-digest > /dev/null 2>&1
# Snapshot CRM quotidien 23h WAT = 22h UTC (fin de journée Bénin)
0 22 * * * . /etc/cron.env; wget -qO- --header="Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/crm-daily-snapshot > /dev/null 2>&1
# Tâches récurrentes : spawn quotidien 06h WAT = 05h UTC (avant la journée de travail)
0 5 * * * . /etc/cron.env; wget -qO- --header="Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/spawn-recurring > /dev/null 2>&1
# Rappel évaluations : 22 du mois 07h WAT = 06h UTC (évaluer le mois en cours avant sa clôture)
0 6 22 * * . /etc/cron.env; wget -qO- --header="Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/monthly-eval-reminder > /dev/null 2>&1
