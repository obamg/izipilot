// ============================================================================
// schema.prisma — IziChange OKR SaaS
// Stack : Next.js 15 + PostgreSQL 16 + Prisma ORM
// Multi-tenant ready (orgId sur toutes les entités)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CEO // Accès total + pilotage global
  MANAGEMENT // Vue synthèse + validation décisions
  PO // Saisie hebdo + vue de son périmètre
  CONTRIBUTOR // Membre d'équipe département — saisie hebdo + statut tâches
  VIEWER // Lecture seule
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum EntityType {
  COMPANY
  DEPARTMENT
  PRODUCT
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

enum KrType {
  NUMERIC // Valeur chiffrée (ex: 500 traders)
  PERCENTAGE // Pourcentage (ex: > 99.5% uptime)
  DATE // Jalon (ex: go-live Avr 2026)
  BINARY // Oui/Non (ex: licence obtenue)
}

enum KrStatus {
  ON_TRACK // 🟢 En bonne voie (≥ 70%)
  AT_RISK // 🟡 Attention (40–69%)
  BLOCKED // 🔴 Bloqué (< 40%)
  NOT_STARTED // ⚪ Non démarré
}

enum ProductStatus {
  ACTIVE
  IN_DEVELOPMENT
  PLANNED
  PAUSED
}

enum AlertType {
  KR_BLOCKED // KR passé en rouge
  KR_DECLINING // KR en baisse 2 semaines de suite
  ENTRY_MISSING // PO n'a pas soumis sa revue lundi
  ESCALATION_48H // Rouge non traité après 48h
  SCORE_BELOW_40 // Score < 40% pendant 3 semaines
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertSource {
  AUTOMATIC
  MANUAL
}

enum DecisionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ActionStatus {
  TODO // À faire
  IN_PROGRESS // En cours
  BLOCKED // Bloquée (avec raison)
  DONE // Terminée
  CANCELLED // Annulée
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT // Liée à un KR rouge — auto-escalade
}

enum SprintStatus {
  PLANNED // Sprint planifié, pas encore démarré
  ACTIVE // Sprint en cours (un seul ACTIVE par org)
  COMPLETED // Sprint clôturé
  CANCELLED // Sprint annulé
}

enum RequestKind {
  INPUT // Besoin d'une contribution / information
  REVIEW // Relecture / validation technique
  APPROVAL // Approbation / signature
  DATA // Données / accès à fournir
  OTHER
}

enum RequestStatus {
  OPEN // En attente de réponse
  RESOLVED // Traitée par la cible
  DECLINED // Refusée par la cible
  CANCELLED // Annulée par le demandeur
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationType {
  WEEKLY_REMINDER // Rappel lundi 8h30
  KR_BLOCKED_ALERT // KR rouge → Management
  ESCALATION_48H // Escalade 48h
  WEEKLY_DIGEST // Digest hebdo Management
  DECISION_DUE // Décision à rendre
  EVAL_REMINDER // Rappel mensuel — évaluez votre équipe
  DAILY_REPORT_REMINDER // Rappel quotidien — remplir le rapport (standup)
  APPRAISAL_REMINDER // Rappel trimestriel — bilans de performance
  SUPPORT_REQUEST_NEW // Nouvelle demande interne adressée au support
  SUPPORT_REQUEST_UPDATE // Changement de statut / réponse sur une demande
  SUPPORT_REQUEST_OVERDUE // Relance — demande dont l'échéance est dépassée
}

enum SessionStatus {
  PENDING // Pas encore ouverte
  OPEN // Saisie en cours (lundi matin)
  CLOSED // Deadline passée
  REVIEWED // CODIR tenu
}

enum AppraisalStatus {
  SELF_ASSESSMENT // Le collègue remplit son auto-évaluation
  MANAGER_ASSESSMENT // Le manager remplit son évaluation
  SHARED // Finalisé et partagé avec le collègue
  ACKNOWLEDGED // Signé / accusé de réception par le collègue
}

// Demandes internes adressées à un département support (IT en premier).
enum SupportRequestCategory {
  INCIDENT // Panne / bug bloquant
  ACCESS // Compte, droits, accès à un outil
  EQUIPMENT // Matériel (poste, écran, téléphone)
  SOFTWARE // Logiciel, licence, installation
  DATA // Extraction, rapport, correction de données
  IMPROVEMENT // Évolution / nouvelle fonctionnalité
  OTHER
}

enum SupportRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Cycle de vie d'une demande. Les états terminaux (RESOLVED → CLOSED, REJECTED,
// CANCELLED) figent la demande : plus d'assignation ni de changement d'échéance.
enum SupportRequestStatus {
  SUBMITTED // Déposée, pas encore prise en charge
  TRIAGED // Prise en charge / assignée
  IN_PROGRESS // Traitement en cours
  ON_HOLD // En attente (info du demandeur ou d'un tiers)
  RESOLVED // Traitée — en attente de clôture du demandeur
  CLOSED // Clôturée
  REJECTED // Refusée par le support
  CANCELLED // Annulée par le demandeur
}

// ============================================================================
// ORGANISATION (Multi-tenant root)
// ============================================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#008081")
  plan         Plan     @default(FREE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users              User[]
  departments        Department[]
  products           Product[]
  objectives         Objective[]
  keyResults         KeyResult[]
  weeklyEntries      WeeklyEntry[]
  weeklySessions     WeeklySession[]
  alerts             Alert[]
  decisions          Decision[]
  actions            Action[]
  crmSnapshots       CrmDailySnapshot[]
  agentSnapshots     AgentDailySnapshot[]
  sprints            Sprint[]
  sprintTasks        SprintTask[]
  sprintCapacities   SprintCapacity[]
  standupEntries     StandupEntry[]
  sprintTaskRequests SprintTaskRequest[]
  sprintTaskSteps    SprintTaskStep[]
  recurringTasks     RecurringTask[]
  evaluations        Evaluation[]
  appraisals         Appraisal[]
  supportRequests    SupportRequest[]
  boardWorkflows     BoardWorkflow[]
  boardColumns       BoardColumn[]

  @@map("organizations")
}

// ============================================================================
// UTILISATEURS & AUTH
// ============================================================================

model User {
  id                 String    @id @default(cuid())
  orgId              String
  email              String    @unique
  name               String
  passwordHash       String?
  avatarUrl          String?
  role               UserRole  @default(VIEWER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  org                        Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownedDepartments           Department[]               @relation("DepartmentOwner")
  ownedProducts              Product[]                  @relation("ProductOwner")
  createdBoardWorkflows      BoardWorkflow[]            @relation("BoardWorkflowCreator")
  ownedKeyResults            KeyResult[]                @relation("KrOwner")
  weeklyEntries              WeeklyEntry[]
  alerts                     Alert[]                    @relation("AlertTriggeredBy")
  resolvedAlerts             Alert[]                    @relation("AlertResolvedBy")
  decisions                  Decision[]                 @relation("DecisionOwner")
  notifications              Notification[]
  sessions                   Session[]
  pushSubscriptions          PushSubscription[]
  assignedActions            Action[]                   @relation("ActionAssignee")
  createdActions             Action[]                   @relation("ActionCreator")
  actionComments             ActionComment[]            @relation("ActionCommentAuthor")
  departmentMembers          DepartmentMember[]
  notificationPrefs          NotificationPreference?
  createdSprints             Sprint[]                   @relation("SprintCreator")
  assignedSprintTasks        SprintTask[]               @relation("SprintTaskAssignee")
  createdSprintTasks         SprintTask[]               @relation("SprintTaskCreator")
  sprintTaskComments         SprintTaskComment[]        @relation("SprintTaskCommentAuthor")
  sprintCapacities           SprintCapacity[]           @relation("SprintCapacityUser")
  standupEntries             StandupEntry[]             @relation("StandupAuthor")
  sprintTaskRequestsMade     SprintTaskRequest[]        @relation("SprintTaskRequestRequester")
  sprintTaskRequestsResolved SprintTaskRequest[]        @relation("SprintTaskRequestResolver")
  sprintTaskRequestsReceived SprintTaskRequest[]        @relation("SprintTaskRequestTargetUser")
  createdSprintTaskSteps     SprintTaskStep[]           @relation("SprintTaskStepCreator")
  recurringTasksCreated      RecurringTask[]            @relation("RecurringTaskCreator")
  recurringTasksAssigned     RecurringTask[]            @relation("RecurringTaskAssignee")
  evaluationsReceived        Evaluation[]               @relation("EvaluationSubject")
  evaluationsGiven           Evaluation[]               @relation("EvaluationEvaluator")
  appraisalsAsSubject        Appraisal[]                @relation("AppraisalSubject")
  appraisalsAsManager        Appraisal[]                @relation("AppraisalManager")
  supportRequestsMade        SupportRequest[]           @relation("SupportRequestRequester")
  supportRequestsAssigned    SupportRequest[]           @relation("SupportRequestAssignee")
  supportRequestsAddressed   SupportRequest[]           @relation("SupportRequestRequestedAssignee")
  supportRequestsClosed      SupportRequest[]           @relation("SupportRequestClosedBy")
  supportedDepartments       Department[]               @relation("DepartmentSupport")
  supportRequestComments     SupportRequestComment[]    @relation("SupportRequestCommentAuthor")
  supportRequestAttachments  SupportRequestAttachment[] @relation("SupportRequestAttachmentUploader")

  @@index([orgId])
  @@index([email])
  @@map("users")
}

// NextAuth.js sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Email-based 2FA. Step 2 of login: after email+password verifies, we issue
// a 6-digit code (bcrypt-hashed) tied to userId. Caller must present it
// within 10 min and within 5 attempts to complete sign-in.
model LoginOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("login_otps")
}

// ============================================================================
// PÉRIMÈTRE — DÉPARTEMENTS
// ============================================================================

model Department {
  id              String   @id @default(cuid())
  orgId           String
  code            String // Ex: "D1", "D2"
  name            String // Ex: "Communication & Marketing"
  color           String // Hex IziChange palette
  description     String?
  ownerId         String // Responsable département
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  // Guichet de demandes internes : quand true, tout le monde peut adresser une
  // demande à ce département (activé pour l'IT). supportUserId = la personne du
  // support qui reçoit les demandes en auto-affectation ; à défaut, le owner.
  acceptsRequests Boolean  @default(false)
  supportUserId   String?
  // Flux de colonnes du tableau pour cette équipe ; null → flux par défaut.
  workflowId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner              User                @relation("DepartmentOwner", fields: [ownerId], references: [id])
  supportUser        User?               @relation("DepartmentSupport", fields: [supportUserId], references: [id], onDelete: SetNull)
  workflow           BoardWorkflow?      @relation("DepartmentWorkflow", fields: [workflowId], references: [id], onDelete: SetNull)
  objectives         Objective[]
  members            DepartmentMember[]
  sprintTasks        SprintTask[]        @relation("SprintTaskDept")
  sprintTaskRequests SprintTaskRequest[] @relation("SprintTaskRequestTargetDept")
  recurringTasks     RecurringTask[]     @relation("RecurringTaskDept")
  supportRequests    SupportRequest[]    @relation("SupportRequestDept")

  @@unique([orgId, code])
  @@index([orgId])
  @@map("departments")
}

model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String
  userId       String
  role         String   @default("MEMBER") // MEMBER | LEAD
  joinedAt     DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
  @@map("department_members")
}

// ============================================================================
// PÉRIMÈTRE — PRODUITS
// ============================================================================

model Product {
  id          String        @id @default(cuid())
  orgId       String
  code        String // Ex: "P1", "P2"
  name        String // Ex: "Plateforme Trading Crypto"
  color       String // Hex IziChange palette
  description String?
  status      ProductStatus @default(ACTIVE)
  ownerId     String // PO du produit
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  // Flux de colonnes du tableau pour cette équipe ; null → flux par défaut.
  workflowId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  org                Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner              User                @relation("ProductOwner", fields: [ownerId], references: [id])
  workflow           BoardWorkflow?      @relation("ProductWorkflow", fields: [workflowId], references: [id], onDelete: SetNull)
  objectives         Objective[]
  sprintTasks        SprintTask[]        @relation("SprintTaskProduct")
  sprintTaskRequests SprintTaskRequest[] @relation("SprintTaskRequestTargetProduct")
  recurringTasks     RecurringTask[]     @relation("RecurringTaskProduct")

  @@unique([orgId, code])
  @@index([orgId])
  @@map("products")
}

// ============================================================================
// OKR — OBJECTIFS
// ============================================================================

model Objective {
  id           String     @id @default(cuid())
  orgId        String
  // Lié à company, département ou produit
  entityType   EntityType
  departmentId String?
  productId    String?
  // Hiérarchie OKR (alignement vertical)
  parentId     String?
  title        String
  why          String? // Pourquoi cet objectif ?
  quarter      Quarter
  year         Int        @default(2026)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id])
  product    Product?     @relation(fields: [productId], references: [id])
  parent     Objective?   @relation("ObjectiveHierarchy", fields: [parentId], references: [id])
  children   Objective[]  @relation("ObjectiveHierarchy")
  keyResults KeyResult[]

  @@index([orgId])
  @@index([orgId, isActive])
  @@index([departmentId])
  @@index([productId])
  @@index([parentId])
  @@map("objectives")
}

// ============================================================================
// OKR — KEY RESULTS
// ============================================================================

model KeyResult {
  id          String @id @default(cuid())
  orgId       String
  objectiveId String
  title       String
  krType      KrType @default(NUMERIC)

  // Cible
  target     Float? // Valeur cible (pour NUMERIC/PERCENTAGE)
  targetUnit String? // Ex: "$", "traders", "%", "resas"
  targetDate String? // Pour KrType.DATE (ex: "Avr 2026")

  // Scoring
  isInverse    Boolean  @default(false) // true = lower is better (ex: coût < 3$)
  currentValue Float    @default(0)
  score        Decimal  @default(0) @db.Decimal(5, 4) // 0.0000 à 1.0000
  status       KrStatus @default(NOT_STARTED)

  // Méta
  ownerId   String // PO responsable de ce KR
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  objective      Objective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner          User            @relation("KrOwner", fields: [ownerId], references: [id])
  weeklyEntries  WeeklyEntry[]
  alerts         Alert[]
  actions        Action[]
  sprintTasks    SprintTask[]    @relation("SprintTaskKr")
  recurringTasks RecurringTask[] @relation("RecurringTaskKr")

  @@index([orgId])
  @@index([objectiveId])
  @@index([ownerId])
  @@index([orgId, status])
  // Every active-KR query filters on (orgId, isActive=true, deletedAt IS NULL);
  // having all three on one index lets Postgres use a single index scan.
  @@index([orgId, isActive, deletedAt])
  @@map("key_results")
}

// ============================================================================
// SAISIE HEBDOMADAIRE — WEEKLY ENTRY (par KR)
// ============================================================================

model WeeklyEntry {
  id          String @id @default(cuid())
  orgId       String
  krId        String
  submittedBy String

  // Période
  weekNumber Int // 1–52 (ISO week)
  year       Int
  weekStart  DateTime // Lundi de la semaine

  // Saisie PO
  progress         Float // % avancement réel (0.0 à 1.0)
  status           KrStatus
  delta            Float    @default(0) // Delta vs semaine précédente
  blocker          String? // Blocage identifié
  proposedSolution String? // Approche de solution (statut AT_RISK)
  actionNeeded     String? // Besoin / décision requise
  comment          String? // Commentaire libre

  // Calculs auto
  scoreAtEntry Decimal @default(0) @db.Decimal(5, 4)

  // Submitted after Sunday 23:59 deadline (within the 24h Monday grace window)
  isLate Boolean @default(false)

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  keyResult KeyResult    @relation(fields: [krId], references: [id], onDelete: Cascade)
  submitter User         @relation(fields: [submittedBy], references: [id])

  @@unique([krId, weekNumber, year])
  @@index([orgId])
  @@index([krId])
  @@index([submittedBy])
  @@index([orgId, weekNumber, year])
  @@map("weekly_entries")
}

// ============================================================================
// SESSION HEBDOMADAIRE GLOBALE
// ============================================================================

model WeeklySession {
  id         String        @id @default(cuid())
  orgId      String
  weekNumber Int
  year       Int
  weekStart  DateTime // Lundi 00:00
  deadline   DateTime // Lundi 09:00 (deadline de saisie)
  status     SessionStatus @default(PENDING)
  notes      String? // Notes du CODIR / stand-up
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  decisions Decision[]

  @@unique([orgId, weekNumber, year])
  @@index([orgId])
  @@map("weekly_sessions")
}

// ============================================================================
// ALERTES
// ============================================================================

model Alert {
  id          String @id @default(cuid())
  orgId       String
  krId        String
  triggeredBy String // userId qui a déclenché (ou "system")

  type     AlertType
  severity AlertSeverity @default(HIGH)
  source   AlertSource   @default(AUTOMATIC)
  message  String

  isResolved Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  resolution String? // Description de la résolution

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  keyResult     KeyResult      @relation(fields: [krId], references: [id], onDelete: Cascade)
  triggerer     User           @relation("AlertTriggeredBy", fields: [triggeredBy], references: [id])
  resolver      User?          @relation("AlertResolvedBy", fields: [resolvedBy], references: [id])
  decisions     Decision[]
  notifications Notification[]

  @@index([orgId])
  @@index([krId])
  // [isResolved] alone is redundant — every list query already filters by
  // orgId, so the composite below covers those reads.
  @@index([orgId, type, isResolved])
  @@index([resolvedBy])
  @@map("alerts")
}

// ============================================================================
// DÉCISIONS (actées en CODIR)
// ============================================================================

model Decision {
  id        String  @id @default(cuid())
  orgId     String
  alertId   String?
  sessionId String?

  title       String
  description String?
  ownerId     String // Responsable de la décision
  dueDate     DateTime? // Date limite d'exécution
  status      DecisionStatus @default(OPEN)

  // Résolution
  outcome  String? // Ce qui a été fait
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  alert   Alert?         @relation(fields: [alertId], references: [id])
  session WeeklySession? @relation(fields: [sessionId], references: [id])
  owner   User           @relation("DecisionOwner", fields: [ownerId], references: [id])

  @@index([orgId])
  @@index([ownerId])
  @@index([status])
  @@index([alertId])
  @@index([sessionId])
  @@map("decisions")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id      String  @id @default(cuid())
  userId  String
  alertId String?

  channel NotificationChannel
  type    NotificationType
  subject String
  body    String              @db.Text

  isSent Boolean   @default(false)
  sentAt DateTime?
  readAt DateTime?

  createdAt DateTime @default(now())

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alert? @relation(fields: [alertId], references: [id])

  @@index([userId])
  @@index([isSent])
  @@index([userId, isSent])
  // check-alerts cron filters by `notifications.alertId = X AND isSent = true`
  // to dedup KR_BLOCKED / ESCALATION_48H emails; without this it scans the
  // whole notifications table on each cron run.
  @@index([alertId])
  @@map("notifications")
}

// ============================================================================
// WEB PUSH SUBSCRIPTIONS (one row per device per user)
// ============================================================================
// Stored unencrypted because the keys are useless without the VAPID private
// key held server-side. We dedup on endpoint — a browser may re-subscribe
// with the same endpoint after refresh, and the unique index turns a re-POST
// into an upsert without creating duplicate rows.

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@map("push_subscriptions")
}

// ============================================================================
// PRÉFÉRENCES DE NOTIFICATION (per-user, per-event email toggles)
// ============================================================================
// Defaults preserve the behavior that existed before this model was added:
// the three events that actually email by default are ON, the two auto
// alerts that intentionally do NOT email (post-f221182) stay OFF here so
// flipping them on later is opt-in.

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  orgId  String

  weeklyReminder      Boolean @default(true) // Sunday 20h reminder to POs
  weeklyDigest        Boolean @default(true) // Monday 10h digest to Mgmt/CEO
  krBlockedManual     Boolean @default(true) // Manual KR alert raised by a user
  escalation48h       Boolean @default(false) // Auto — currently never emails
  entryMissing        Boolean @default(false) // Auto — currently never emails
  dailyReportReminder Boolean @default(true) // Working-day standup reminder
  supportRequest      Boolean @default(true) // Demandes internes : nouvelle demande, suivi, relance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("notification_preferences")
}

// ============================================================================
// ACTIONS (suivi des tâches par Key Result)
// ============================================================================

model Action {
  id            String         @id @default(cuid())
  orgId         String
  krId          String
  title         String
  description   String?        @db.Text
  assigneeId    String
  createdById   String
  status        ActionStatus   @default(TODO)
  priority      ActionPriority @default(MEDIUM)
  dueDate       DateTime?
  completedAt   DateTime?
  weekCreated   Int // Semaine ISO de création
  weekCompleted Int? // Semaine ISO de complétion
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  keyResult KeyResult       @relation(fields: [krId], references: [id], onDelete: Cascade)
  assignee  User            @relation("ActionAssignee", fields: [assigneeId], references: [id])
  createdBy User            @relation("ActionCreator", fields: [createdById], references: [id])
  comments  ActionComment[]

  @@index([orgId])
  @@index([krId])
  @@index([assigneeId])
  @@index([orgId, status])
  @@index([createdById])
  @@map("actions")
}

model ActionComment {
  id        String   @id @default(cuid())
  actionId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Relations
  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  author User   @relation("ActionCommentAuthor", fields: [authorId], references: [id])

  @@index([actionId])
  @@index([authorId])
  @@map("action_comments")
}

// ============================================================================
// SPRINTS (exécution time-boxée — org-wide, board filtrable par équipe)
// ============================================================================

model Sprint {
  id            String       @id @default(cuid())
  orgId         String
  number        Int // Numéro auto-incrémenté par org (ex: "Sprint 12")
  name          String
  goal          String?      @db.Text
  status        SprintStatus @default(PLANNED)
  startDate     DateTime
  endDate       DateTime
  createdById   String
  completedAt   DateTime?
  // Stats frozen at close (SprintStats shape) so committed/done figures survive
  // unfinished tasks being carried out to the next sprint. Null until closed.
  statsSnapshot Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("SprintCreator", fields: [createdById], references: [id])
  tasks      SprintTask[]
  capacities SprintCapacity[]
  standups   StandupEntry[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@map("sprints")
}

model SprintTask {
  id              String         @id @default(cuid())
  orgId           String
  sprintId        String? // null = backlog (pas encore dans un sprint)
  krId            String? // Lien optionnel vers un Key Result
  departmentId    String? // Tag équipe (filtre board)
  productId       String? // Tag équipe (filtre board)
  recurringTaskId String? // Origine : généré par un modèle récurrent
  // Colonne du tableau (flux de l'équipe). Null = tâche non encore placée : le
  // board la range alors dans la première colonne de sa catégorie `status`.
  columnId        String?
  title           String
  description     String?        @db.Text
  reportUrl       String? // Lien vers le rapport de tâche (document externe)
  // Projection dénormalisée de column.category, réécrite à chaque déplacement.
  // Source unique pour toutes les métriques (voir lib/sprint.ts) : garder le
  // scalaire évite un join sur chaque calcul et préserve l'index ci-dessous.
  status          ActionStatus   @default(TODO)
  priority        ActionPriority @default(MEDIUM)
  storyPoints     Int? // Estimation (capacité / vélocité)
  assigneeId      String?
  createdById     String
  sortOrder       Int            @default(0) // Ordre dans une colonne du board
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  org             Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sprint          Sprint?             @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  keyResult       KeyResult?          @relation("SprintTaskKr", fields: [krId], references: [id], onDelete: SetNull)
  department      Department?         @relation("SprintTaskDept", fields: [departmentId], references: [id], onDelete: SetNull)
  product         Product?            @relation("SprintTaskProduct", fields: [productId], references: [id], onDelete: SetNull)
  assignee        User?               @relation("SprintTaskAssignee", fields: [assigneeId], references: [id])
  createdBy       User                @relation("SprintTaskCreator", fields: [createdById], references: [id])
  comments        SprintTaskComment[]
  requests        SprintTaskRequest[]
  steps           SprintTaskStep[]
  supportRequests SupportRequest[]    @relation("SupportRequestTask")
  recurringTask   RecurringTask?      @relation("SprintTaskRecurring", fields: [recurringTaskId], references: [id], onDelete: SetNull)
  column          BoardColumn?        @relation(fields: [columnId], references: [id], onDelete: SetNull)

  @@index([orgId, sprintId, status])
  @@index([columnId])
  @@index([assigneeId])
  @@index([krId])
  @@index([departmentId])
  @@index([productId])
  @@index([recurringTaskId])
  @@map("sprint_tasks")
}

// Demande d'input adressée à un·e coéquipier·e OU à une équipe (produit/dépt).
// La cible résout / refuse (workflow à deux côtés). Une demande OPEN affiche un
// indicateur sur la carte sans modifier le statut réel de la tâche.
model SprintTaskRequest {
  id                 String        @id @default(cuid())
  orgId              String
  taskId             String
  requestedById      String
  kind               RequestKind   @default(INPUT)
  message            String        @db.Text
  // Cible polymorphe : exactement un des trois est renseigné (app-enforced).
  targetUserId       String?
  targetDepartmentId String?
  targetProductId    String?
  status             RequestStatus @default(OPEN)
  resolvedById       String?
  resolvedAt         DateTime?
  resolutionNote     String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task             SprintTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy      User         @relation("SprintTaskRequestRequester", fields: [requestedById], references: [id])
  resolvedBy       User?        @relation("SprintTaskRequestResolver", fields: [resolvedById], references: [id])
  targetUser       User?        @relation("SprintTaskRequestTargetUser", fields: [targetUserId], references: [id])
  targetDepartment Department?  @relation("SprintTaskRequestTargetDept", fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  targetProduct    Product?     @relation("SprintTaskRequestTargetProduct", fields: [targetProductId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([taskId])
  @@index([targetUserId])
  @@index([targetDepartmentId])
  @@index([targetProductId])
  @@map("sprint_task_requests")
}

model SprintTaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Relations
  task   SprintTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User       @relation("SprintTaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId])
  @@index([authorId])
  @@map("sprint_task_comments")
}

// Étape (checklist) d'une SprintTask : un titre + une case cochée, ordonnée.
// La progression (done/total) est agrégée sur la carte du board.
model SprintTaskStep {
  id          String   @id @default(cuid())
  orgId       String
  taskId      String
  title       String
  done        Boolean  @default(false)
  createdById String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task      SprintTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User         @relation("SprintTaskStepCreator", fields: [createdById], references: [id])

  @@index([taskId])
  @@index([orgId])
  @@map("sprint_task_steps")
}

// ============================================================================
// FLUX DE TRAVAIL (colonnes de tableau configurables par équipe)
// ============================================================================

// Le « seau » sémantique d'une colonne. Une équipe crée autant de colonnes
// qu'elle veut, mais chacune retombe dans l'une de ces cinq catégories — et
// c'est la catégorie, jamais le libellé, que lisent les métriques (stats de
// sprint, burndown, vélocité, report au sprint suivant, évaluation).
// Volontairement aligné sur ActionStatus : SprintTask.status en est la
// projection dénormalisée, entretenue à chaque déplacement de carte.
enum BoardColumnCategory {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

// Un jeu de colonnes partageable. Chaque département / produit pointe vers un
// flux ; ceux qui n'en désignent aucun utilisent le flux par défaut de l'org.
// L'indirection évite de dupliquer 15 jeux de colonnes quasi identiques quand
// trois équipes travaillent de la même façon.
model BoardWorkflow {
  id          String   @id @default(cuid())
  orgId       String
  name        String // Ex: "Flux par défaut", "Flux IT"
  description String?
  // Exactement un par org (app-enforced) : filet de sécurité pour toute équipe
  // sans flux désigné, et indestructible pour cette raison.
  isDefault   Boolean  @default(false)
  // Auteur du flux. Sert à trancher les droits d'un PO sur un flux qui n'est
  // encore rattaché à aucune équipe : sans équipe, la règle « toutes les
  // équipes m'appartiennent » serait vraie pour tout le monde. Null pour le
  // flux par défaut (créé par la migration ou le seed, pas par une personne).
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("BoardWorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  columns     BoardColumn[]
  departments Department[]  @relation("DepartmentWorkflow")
  products    Product[]     @relation("ProductWorkflow")

  @@unique([orgId, name])
  @@index([orgId])
  @@map("board_workflows")
}

// Une colonne du tableau. `label` et `color` sont libres ; `category` porte le
// sens. wipLimit = nombre max de cartes avant alerte visuelle (0/null = aucune).
model BoardColumn {
  id         String              @id @default(cuid())
  orgId      String
  workflowId String
  label      String
  color      String              @default("#5f6e7a")
  category   BoardColumnCategory
  sortOrder  Int                 @default(0)
  wipLimit   Int?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // Relations
  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflow BoardWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks    SprintTask[]

  @@index([workflowId, sortOrder])
  @@index([orgId])
  @@map("board_columns")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  PER_SPRINT // Une fois par sprint — déclenché à l'activation du sprint (pas de date)
}

// Modèle de tâche récurrente : un gabarit qu'un cron clone en SprintTask réelle
// à chaque échéance (quotidienne / hebdo / mensuelle). La tâche générée atterrit
// dans le sprint ACTIF de l'org, sinon dans le backlog.
model RecurringTask {
  id           String         @id @default(cuid())
  orgId        String
  title        String
  description  String?        @db.Text
  krId         String?
  departmentId String?
  productId    String?
  priority     ActionPriority @default(MEDIUM)
  storyPoints  Int?
  assigneeId   String?
  createdById  String

  // Configuration de la récurrence
  frequency RecurrenceFrequency
  weekday   Int? // 0 = dimanche … 6 = samedi (WEEKLY)
  monthDay  Int? // 1 … 28 (MONTHLY ; borné à 28 pour exister chaque mois)
  isActive  Boolean             @default(true) // pause / reprise
  nextRunAt DateTime? // prochaine échéance (00:00 UTC) ; null pour PER_SPRINT (piloté par l'activation du sprint)
  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  keyResult      KeyResult?   @relation("RecurringTaskKr", fields: [krId], references: [id], onDelete: SetNull)
  department     Department?  @relation("RecurringTaskDept", fields: [departmentId], references: [id], onDelete: SetNull)
  product        Product?     @relation("RecurringTaskProduct", fields: [productId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("RecurringTaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User         @relation("RecurringTaskCreator", fields: [createdById], references: [id])
  generatedTasks SprintTask[] @relation("SprintTaskRecurring")

  @@index([orgId, isActive, nextRunAt])
  @@map("recurring_tasks")
}

model SprintCapacity {
  id             String  @id @default(cuid())
  orgId          String
  sprintId       String
  userId         String
  capacityPoints Int     @default(0) // Points qu'un membre peut prendre sur le sprint
  notes          String?

  // Relations
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sprint Sprint       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User         @relation("SprintCapacityUser", fields: [userId], references: [id])

  @@unique([sprintId, userId])
  @@index([orgId])
  @@map("sprint_capacities")
}

// Daily standup ceremony: one entry per member, per sprint, per day.
// In-app only (no email/cron). Aggregated into the "Rapport quotidien" tab.
model StandupEntry {
  id        String   @id @default(cuid())
  orgId     String
  sprintId  String
  userId    String
  date      DateTime @db.Date // Jour du standup (date calendaire WAT)
  yesterday String?  @db.Text // "Hier"
  today     String?  @db.Text // "Aujourd'hui"
  blockers  String?  @db.Text // "Blocage"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sprint Sprint       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user   User         @relation("StandupAuthor", fields: [userId], references: [id])

  @@unique([sprintId, userId, date])
  @@index([orgId, sprintId, date])
  @@map("standup_entries")
}

// ============================================================================
// OAuth 2.1 — MCP CONNECTOR (Claude.ai)
// ============================================================================
// Each Claude.ai install self-registers a client via Dynamic Client
// Registration (RFC 7591). Per-user binding happens at the consent step:
// the auth code is bound to (clientId, userId), and the resulting refresh
// token carries the same pair. One client can in principle be reused by
// multiple users — in practice Claude.ai registers a fresh client per
// workspace, so revoking refresh tokens is per-user-per-client.

model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientSecretHash        String // bcrypt of the client secret
  clientName              String
  redirectUris            String[] // RFC 7591 — exact match required at /authorize
  tokenEndpointAuthMethod String   @default("client_secret_post")
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  responseTypes           String[] @default(["code"])
  scope                   String   @default("mcp")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  authCodes     OAuthAuthCode[]
  refreshTokens OAuthRefreshToken[]

  @@index([clientId])
  @@map("oauth_clients")
}

model OAuthAuthCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique // sha256 of the raw code (codes are short-lived but still hash at rest)
  clientId            String
  userId              String
  orgId               String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  scope               String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
  @@map("oauth_auth_codes")
}

model OAuthRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the raw refresh token
  clientId  String
  userId    String
  orgId     String
  scope     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("oauth_refresh_tokens")
}

// ============================================================================
// CRM — DAILY SNAPSHOTS (Gleap rolling history pour deltas "vs hier")
// ============================================================================

model CrmDailySnapshot {
  id              String   @id @default(cuid())
  orgId           String
  gleapProjectKey String // "TRADING" | "AFRICAPART" | "SHARED"
  snapshotDate    DateTime @db.Date

  openTickets         Int?
  totalTickets        Int?
  slaBreachedInSample Int?
  sampleSize          Int?
  agentsActive        Int?

  capturedAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, gleapProjectKey, snapshotDate])
  @@index([orgId, snapshotDate])
  @@map("crm_daily_snapshots")
}

// ============================================================================
// CRM — AGENT DAILY ACTIVITY (one row per agent / project / calendar day)
// ============================================================================
// snapshotDate = the calendar day of activity (UTC), not the day of capture.
// The cron at 04h UTC captures the previous full UTC day, filtering tickets
// by `updatedAt` within [00h UTC, 24h UTC) of that day.
// Limitation: when a single project sees > 500 ticket-updates in one day the
// sample is truncated by Gleap's API and counts will be a lower bound.

model AgentDailySnapshot {
  id              String   @id @default(cuid())
  orgId           String
  gleapProjectKey String // "TRADING" | "AFRICAPART" | "SHARED"
  snapshotDate    DateTime @db.Date

  agentId    String // Gleap user id
  agentName  String
  agentEmail String?

  ticketsHandled     Int    @default(0)
  slaBreached        Int    @default(0)
  avgResolutionHours Float?

  capturedAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, gleapProjectKey, snapshotDate, agentId])
  @@index([orgId, snapshotDate])
  @@map("agent_daily_snapshots")
}

// ============================================================================
// ÉVALUATIONS — notation mensuelle des collègues (/5), hybride
// ============================================================================
// Score global = 60 % livraison (auto, à partir des points livrés vs engagés
// sur les sprints du mois) + 40 % moyenne des critères manuels. Les valeurs
// auto sont figées à l'enregistrement (statsSnapshot) car les tâches/capacités
// évoluent. Un seul avis par (évalué, évaluateur, mois, année).

model Evaluation {
  id          String @id @default(cuid())
  orgId       String
  subjectId   String // collègue évalué
  evaluatorId String // auteur de la note
  periodMonth Int // 1–12
  periodYear  Int

  // Critères manuels (1–5)
  scoreQuality       Int
  scoreCollaboration Int
  scoreInitiative    Int

  // Livraison auto (0–5) figée au moment de l'évaluation, puis global pondéré.
  deliveryScore Decimal? @db.Decimal(3, 1)
  overall       Decimal  @db.Decimal(3, 1)

  comment       String?
  statsSnapshot Json? // { deliveredPoints, committedPoints, ratio, tasksDone, onTimeRate }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subject   User         @relation("EvaluationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  evaluator User         @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([subjectId, evaluatorId, periodMonth, periodYear])
  @@index([orgId, periodYear, periodMonth])
  @@index([subjectId])
  @@map("evaluations")
}

// Bilan trimestriel (performance appraisal) — revue formelle self + manager,
// bâtie sur les évaluations mensuelles (rollup) : un par collègue par trimestre.
model Appraisal {
  id        String          @id @default(cuid())
  orgId     String
  subjectId String // personne évaluée
  managerId String // évaluateur / manager
  quarter   Quarter
  year      Int
  status    AppraisalStatus @default(SELF_ASSESSMENT)

  // Auto-évaluation (côté collègue)
  selfCompetencies Json? // { [competencyKey]: 1–5 }
  selfComment      String?   @db.Text
  selfSubmittedAt  DateTime?

  // Évaluation manager
  managerCompetencies Json? // { [competencyKey]: 1–5 }
  strengths           String?   @db.Text // Points forts
  improvements        String?   @db.Text // Axes d'amélioration
  developmentPlan     String?   @db.Text // Plan de développement
  managerComment      String?   @db.Text
  managerSubmittedAt  DateTime?

  // Objectifs de la période (partagés self + manager)
  goals Json? // [{ id, title, selfRating, selfComment, managerRating, managerComment }]

  // Synthèse
  monthlyRollup Json? // instantané des moyennes mensuelles du trimestre (figé à la finalisation)
  overall       Decimal? @db.Decimal(3, 1)

  // Signature du collègue
  acknowledgedAt     DateTime?
  acknowledgeComment String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subject User         @relation("AppraisalSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  manager User         @relation("AppraisalManager", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([subjectId, quarter, year])
  @@index([orgId, year, quarter])
  @@index([managerId])
  @@map("appraisals")
}

// ============================================================================
// DEMANDES INTERNES (guichet support — IT en premier)
// ============================================================================
// Une demande est déposée par n'importe quel utilisateur et adressée à un
// département ouvert aux demandes (`Department.acceptsRequests`). Elle est
// auto-affectée au `supportUser` du département, à défaut à son `owner`.
// Traitée par : l'assigné, le support/owner du département, ses membres,
// et le CEO/MANAGEMENT. Le demandeur garde la lecture + l'annulation + la
// clôture de sa propre demande.

model SupportRequest {
  id        String @id @default(cuid())
  orgId     String
  // Référence lisible affichée aux utilisateurs, ex "IT-2026-0042". Unique par
  // org : c'est ce que les gens citent en réunion ou dans un message.
  reference String

  requesterId         String
  departmentId        String // Département destinataire (IT)
  assigneeId          String? // Personne du support en charge
  // Personne que le demandeur a explicitement visée. Sert d'affectation
  // initiale, puis reste comme trace : le support peut réassigner, mais on
  // garde ce que le demandeur avait souhaité au départ.
  requestedAssigneeId String?

  category SupportRequestCategory @default(OTHER)
  priority SupportRequestPriority @default(NORMAL)
  status   SupportRequestStatus   @default(SUBMITTED)

  title       String
  description String @db.Text

  // SLA : échéance cible dérivée de la priorité à la création, ajustable par le
  // support. `firstResponseAt` est figé au premier commentaire du support ou à
  // la prise en charge — sert au délai de première réponse dans les stats.
  dueAt                 DateTime?
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  closedById            String?
  resolutionNote        String?   @db.Text
  // Dernière relance de retard envoyée — dédup du cron quotidien.
  lastOverdueNotifiedAt DateTime?

  // Chantier réel : la demande a été convertie en tâche de sprint.
  taskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  org               Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requester         User                       @relation("SupportRequestRequester", fields: [requesterId], references: [id])
  department        Department                 @relation("SupportRequestDept", fields: [departmentId], references: [id], onDelete: Cascade)
  assignee          User?                      @relation("SupportRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requestedAssignee User?                      @relation("SupportRequestRequestedAssignee", fields: [requestedAssigneeId], references: [id], onDelete: SetNull)
  closedBy          User?                      @relation("SupportRequestClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  task              SprintTask?                @relation("SupportRequestTask", fields: [taskId], references: [id], onDelete: SetNull)
  comments          SupportRequestComment[]
  attachments       SupportRequestAttachment[]

  @@unique([orgId, reference])
  @@index([orgId, status])
  @@index([orgId, departmentId, status])
  @@index([requesterId])
  @@index([assigneeId])
  // Le cron de relance filtre les demandes ouvertes dont l'échéance est passée.
  @@index([orgId, dueAt])
  @@index([taskId])
  @@map("support_requests")
}

// Fil d'échange demandeur ↔ support. `isInternal` = note interne au support,
// jamais renvoyée au demandeur (filtrée côté serveur, pas seulement à l'affichage).
model SupportRequestComment {
  id         String   @id @default(cuid())
  requestId  String
  authorId   String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation("SupportRequestCommentAuthor", fields: [authorId], references: [id])

  @@index([requestId])
  @@index([authorId])
  @@map("support_request_comments")
}

// Pièce jointe stockée sur le volume de l'app (voir lib/storage.ts).
// `storageKey` est un chemin relatif opaque — jamais le nom de fichier fourni
// par l'utilisateur, qui reste affiché tel quel via `filename`.
model SupportRequestAttachment {
  id           String   @id @default(cuid())
  requestId    String
  uploadedById String
  filename     String
  mimeType     String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  request    SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("SupportRequestAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([requestId])
  @@map("support_request_attachments")
}
